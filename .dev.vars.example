# Obligatorias. Estos mismos nombres hay que definirlos en
# Cloudflare Pages -> Settings -> Environment variables (Production).
RESEND_API_KEY=re_xxxxxxxxxxxx

# Remitente. Tiene que ser una direccion del dominio verificado en Resend
# (mail.clcolor.com). No es un buzon real: nadie lee lo que llegue ahi, por eso
# la Function pone el correo del visitante en reply_to.
CONTACT_FROM_EMAIL=CleanLineColor Studio <formulario@mail.clcolor.com>

# Destinatario: el buzon del cliente en Hostinger. Es el que la empresa revisa.
# OJO: durante meses esto apunto a una direccion personal y al correo de
# pruebas de Resend, y por eso los formularios no llegaban a CLC.
CONTACT_TO_EMAIL=contacto@clcolor.com

# Opcional para desarrollo local. En produccion SI esta configurada: el
# widget de Turnstile en index.html usa el sitekey publico de CLC
# (0x4AAAAAAEphAHkLhJU95ppR), y /api/contact exige el token en cuanto esta
# variable existe. En local, sin ella, el formulario sigue funcionando
# igual -- protegido solo por el campo trampa y el limite por IP -- porque
# el widget real no resuelve en localhost salvo que uses las claves de
# prueba de Cloudflare (ver docs/superpowers/reports/2026-09-05-turnstile.md).
# TURNSTILE_SECRET_KEY=0x4xxxxxxxxxxxxxxxxxxxxxxxx

# Binding de KV (se crea en el panel de Pages, no aqui): un namespace llamado
# CONTACTOS. Si existe, cada envio se guarda antes de llamar a Resend y se
# aplica un limite de 5 envios por IP cada 10 minutos.
